{
  "name": "kronos-aranha-digital",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:candles": "tsx --test tests/candle-validation.test.ts",
    "import:binance": "tsx server/binance-historical-import.ts",
    "test:binance": "tsx --test tests/binance-feed.test.ts",
    "test:replay": "tsx --test tests/historical-replay.test.ts",
    "test:import": "tsx --test tests/binance-import.test.ts tests/gap-backfill.test.ts",
    "test:health": "tsx --test tests/health.test.ts",
    "test:history": "tsx --test tests/history-window.test.ts",
    "test:signals": "tsx --test tests/signals.test.ts",
    "test:breaker": "tsx --test tests/circuit-breaker.test.ts",
    "test:paper": "tsx --test tests/trading-math.test.ts tests/paper-broker.test.ts tests/telegram.test.ts",
    "test:backtest": "tsx --test tests/backtest.test.ts",
    "test:aranha": "tsx --test tests/aranha-analogs.test.ts tests/aranha-structures.test.ts tests/aranha-web.test.ts tests/aranha-fusion.test.ts tests/aranha-backtest.test.ts tests/aranha-llm-status.test.ts",
    "test": "npm run test:candles && npm run test:binance && npm run test:import && npm run test:replay && npm run test:health && npm run test:history && npm run test:signals && npm run test:breaker && npm run test:paper && npm run test:backtest && npm run test:aranha",
    "check": "npm test && npm run build && python3 -m py_compile server/kronos_worker.py && bash -n scripts/setup-kronos.sh",
    "backtest": "tsx server/backtest-cli.ts",
    "backtest:aranha": "tsx server/aranha/cli.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "ws": "^8.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.380.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/ws": "^8.5.10",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "tsx": "^4.10.5",
    "concurrently": "^8.2.2"
  }
}
