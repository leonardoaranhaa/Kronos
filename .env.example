PORT=3000

# Deploy público. 1 aceita só GET, HEAD e o WebSocket /ws, e apaga chave de corretora do processo.
# PUBLIC_READONLY=
# Pasta gravada pelo coletor. No Fly o volume fica em /data.
# DATA_DIR=

# Public market-data ingestion only. No API key or secret is required.
FEED_MODE=binance
SYMBOL=BTCUSDT
TIMEFRAME=5m
BINANCE_REST_BASE_URL=https://data-api.binance.vision
BINANCE_WS_BASE_URL=wss://data-stream.binance.vision/ws
HISTORICAL_DATA_PATH=

# Official Kronos source checkout and pretrained Hugging Face artifacts.
KRONOS_PYTHON_PATH=python3
KRONOS_REPO_PATH=./external/Kronos
KRONOS_UPSTREAM_COMMIT=67b630e67f6a18c9e9be918d9b4337c960db1e9a
KRONOS_MODEL_ID=NeoQuasar/Kronos-small
KRONOS_TOKENIZER_ID=NeoQuasar/Kronos-Tokenizer-base
KRONOS_DEVICE=
KRONOS_MAX_CONTEXT=400
KRONOS_PREDICTION_HORIZON=5
# Samples per forecast. 1 keeps the previous single path. Above 1 also returns P(up) and a 10/50/90 band.
KRONOS_SAMPLE_COUNT=1

# Optional historical import range (Unix milliseconds). If START_TIME is empty,
# the importer fetches the most recent 1,000 intervals. A backtest of several
# weeks needs a longer START_TIME.
START_TIME=
END_TIME=

# Paper simulation. These are research settings, not exchange credentials.
PAPER_STARTING_EQUITY=10000
PAPER_POSITION_FRACTION=1
PAPER_FEE_RATE=0.001
PAPER_SLIPPAGE_RATE=0.0005
PAPER_MIN_MOVE_BPS=30
PAPER_RSI_BUY_MAX=70
PAPER_RSI_SELL_MIN=30
BREAKER_MAX_DAILY_DRAWDOWN_PCT=2
BREAKER_MAX_CONSECUTIVE_LOSSES=3
BREAKER_COOLDOWN_MS=1800000
BREAKER_FEED_TIMEOUT_MS=30000
AUDIT_LOG_PATH=data/audit/paper.jsonl
PAPER_STATE_PATH=data/paper/state.json
BACKTEST_CONTEXT=400
BACKTEST_HORIZON=5
BACKTEST_STRIDE=12
BACKTEST_RANDOM_SEED=42
BACKTEST_REPORT_PATH=reports/backtest-latest.json

# Optional paper rule. Leave empty for the current default.
# "pesquisa" is used only if reports/research-m2.json says the out-of-sample test passed,
# and only when SYMBOL=BTCUSDT and TIMEFRAME=1h.
PAPER_STRATEGY=

# Optional Telegram alerts. Leave both empty to disable.
# Messages say that no real order was sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Aranha Digital. Empty keys keep the word-list fallback and the panel says "LLM desligado".
# Never put a real key in this file.
ARANHA_LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2026-10-21
ANTHROPIC_WEB_SEARCH_TOOL=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
ARANHA_FILTER=0
ARANHA_WEB=1
ARANHA_CHART_IMAGE=1
ARANHA_ANALOG_WINDOW=48
ARANHA_ANALOG_HORIZON=12
ARANHA_ANALOG_K=8
ARANHA_STRIDE=12
ARANHA_CACHE_DIR=data/aranha/cache
ARANHA_SNAPSHOT_DIR=data/aranha/snapshots
ARANHA_REPORT_PATH=reports/aranha-latest.json
ARANHA_LLM_MIN_INTERVAL_MS=600000
ARANHA_WEB_MIN_REFRESH_MS=600000

# Crypto crawler. Public market data only. Leave the optional keys empty.
CRAWLER_ENABLED=1
CRAWLER_UNIVERSE_SIZE=40
CRAWLER_KRONOS_TOP=3
CRAWLER_WHALE_USD=100000
CRAWLER_BTC_WHALE=10
CRAWLER_ETH_WHALE_USD=500000
CRAWLER_SYMBOLS=
CRAWLER_REFRESH_MS=60000
CRAWLER_SNAPSHOT_DIR=data/crawler
CRAWLER_REPORT_PATH=reports/crawler-latest.json
WHALE_ALERT_API_KEY=
ETHERSCAN_API_KEY=

# Public USD-M futures. No API key. DATA_DIR=/data on Fly puts files in /data/futures.
# FUTURES_LIVE=0 leaves the collector off. The default follows the research server.
# FUTURES_LIVE=1
# DATA_DIR=
# FUTURES_DIR=
# FUTURES_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# FUTURES_REST_BASE=https://fapi.binance.com
# FUTURES_WS_BASE=wss://fstream.binance.com/ws
# FUTURES_REFRESH_MS=60000
